# Defaults need no infrastructure: in-process bus, Node's built-in SQLite.
PORT=8080
BUS=memory            # memory | kafka
STORE=sqlite          # sqlite | postgres
SQLITE_PATH=streamtally.db

# Used only when BUS=kafka / STORE=postgres (see docker-compose.yml).
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=events
KAFKA_GROUP_ID=streamtally-aggregator
DATABASE_URL=postgres://streamtally:streamtally@localhost:5432/streamtally

# Aggregator batching. Bigger batches amortise the per-transaction cost.
BATCH_SIZE=500
BATCH_LINGER_MS=50
