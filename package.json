{
  "name": "streamtally",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time event analytics with an exactness harness that tries to make the counts wrong",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build:web": "vite build web",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify:exactness": "tsx verify/exactness.ts",
    "bench": "tsx bench/run.ts",
    "dev:web": "vite web",
    "demo": "npm run build:web && npm start",
    "traffic": "tsx scripts/traffic.ts",
    "capture:demo": "tsx scripts/capture-demo.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autocannon": "^8.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
